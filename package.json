  "scripts": {
    "clean": "if exist node_modules\\.cache rmdir /s /q node_modules\\.cache & if exist .angular rmdir /s /q .angular || exit 0",
    "clean:full": "if exist node_modules rmdir /s /q node_modules & if exist package-lock.json del package-lock.json & if exist .angular rmdir /s /q .angular & if exist dist rmdir /s /q dist || exit 0",
    "postinstall": "exit 0",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
